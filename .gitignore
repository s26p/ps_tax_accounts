#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# PS Tax Consultancy - Security
**/.env
**/.env.*
!**/.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local databases
*.db
*.sqlite
*.sqlite3

# Firebase service account credentials
**/*service-account*.json
**/*serviceAccount*.json

# Local dependencies and generated files
**/node_modules/

# Local backups - never upload to GitHub
/backups/
/backup_before_changes/
/security_backup_*/

# Local backup files
*.bak

# Flutter generated ephemeral files
**/Flutter/ephemeral/
**/ephemeral/

# Old source backups
*.before_*
database_helper_before_fix.txt

# Exclude all old backup source files
*.backup*
*_backup*
*_before_*
*.fix-backup-*
*.login-debug-backup

# Exclude generated build folders everywhere
**/build/

# Exclude personal signature
/assets/images/signature.png

# Exclude every old backup and temporary source copy
*-backup*
*.before-*
*.pre-*
*.old
*.bak
